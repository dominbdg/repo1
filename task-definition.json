{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "mytask-definition",
    "containerDefinitions": [
        {
            "name": "nginx",
            "image": "nginx:1.28-alpine",
            "portMappings": [{
                "name": "nginx-port",
                "containerPort": 80
            }],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "3 GB",
    "cpu": "1 vCPU",
    "executionRoleArn": ""
}