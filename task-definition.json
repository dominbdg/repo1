{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "mytask",
    "containerDefinitions": [
        {
            "name": "nginx",
            "image": "nginx:latest",
            "essential": true,
            "portMappings": [{
                "containerPort": 80,
                "hostPort": 80
            }]
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "3 GB",
    "cpu": "1 vCPU",
    "executionRoleArn": ""
}    